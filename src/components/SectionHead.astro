---
interface Props {
  index: string;
  label: string;
  title: string;
  id?: string;
}
const { index, label, title, id } = Astro.props;
---

<header class="section-head">
  <p class="label" data-reveal>{index} — {label}</p>
  <h2 id={id} class="section-head__title" data-reveal>{title}</h2>
  {
    Astro.slots.has('default') && (
      <div class="section-head__intro" data-reveal>
        <slot />
      </div>
    )
  }
</header>

<style>
  .section-head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .section-head__title {
    font-size: var(--fs-2xl);
    max-width: 16ch;
  }
  .section-head__intro {
    max-width: 38rem;
    font-size: var(--fs-lg);
    color: var(--c-text-muted);
  }
</style>
