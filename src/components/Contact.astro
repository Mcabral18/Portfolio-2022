---
import { site } from '../data/site';
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="contact__glow" aria-hidden="true"></div>
  <div class="container contact__grid">
    <div>
      <p class="label" data-reveal>05 — Contact</p>
      <h2 id="contact-title" class="contact__title" data-reveal>
        Let's build something <span class="contact__accent">remarkable.</span>
      </h2>
      <p class="contact__intro" data-reveal>
        Have a product, a role or an idea worth exploring? Find me on LinkedIn or browse my code on GitHub.
      </p>
    </div>

    <ul class="channels" data-reveal>
      <li>
        <a class="channel" href={site.social.linkedin} target="_blank" rel="noopener">
          <span class="channel__kind">Connect</span>
          <span class="channel__name">LinkedIn</span>
          <svg width="18" height="18" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 10L10 2M4 2h6v6" stroke="currentColor" stroke-width="1.2"></path>
          </svg>
        </a>
      </li>
      <li>
        <a class="channel" href={site.social.github} target="_blank" rel="noopener">
          <span class="channel__kind">Code</span>
          <span class="channel__name">GitHub</span>
          <svg width="18" height="18" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 10L10 2M4 2h6v6" stroke="currentColor" stroke-width="1.2"></path>
          </svg>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    background: var(--c-ink-deeper);
  }
  .contact__glow {
    position: absolute;
    right: -15vw;
    bottom: -30vw;
    width: 70vw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(17 100 102 / 0.55), rgb(17 100 102 / 0.12) 45%, transparent 70%);
    pointer-events: none;
  }

  .contact__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 1rem + 5vw, 7rem);
    align-items: end;
  }

  .contact__title {
    margin-top: 1.5rem;
    font-size: clamp(2.5rem, 1rem + 6vw, 6.5rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    max-width: 14ch;
  }
  .contact__accent {
    color: var(--c-peach);
  }
  .contact__intro {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: var(--fs-lg);
    color: var(--c-text-muted);
  }

  .channels {
    border-top: 1px solid var(--c-line-strong);
  }
  .channel {
    display: grid;
    grid-template-columns: 6rem 1fr auto;
    align-items: center;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--c-line-strong);
    transition: color 0.3s, padding 0.5s var(--ease-out);
  }
  .channel__kind {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }
  .channel__name {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    font-weight: 500;
  }
  .channel svg {
    transition: transform 0.4s var(--ease-out);
  }
  .channel:hover {
    color: var(--c-peach);
    padding-left: 0.75rem;
  }
  .channel:hover svg {
    transform: translate(4px, -4px);
  }

  @media (max-width: 860px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
