---
import SectionHead from './SectionHead.astro';
import { expertise, marquee } from '../data/expertise';
---

<section id="expertise" class="section expertise" aria-labelledby="expertise-title">
  <div class="container">
    <SectionHead index="03" label="Expertise" title="The stack I think in." id="expertise-title">
      <p>
        Modular component architecture, predictable state and performance budgets — plus a deep toolbox for maps, 3D
        and immersive media.
      </p>
    </SectionHead>

    <div class="xp-grid" data-spotlight>
      {
        expertise.map((x) => (
          <article class="xp-card" data-reveal>
            <p class="xp-card__code">[{x.code}]</p>
            <h3 class="xp-card__title">{x.title}</h3>
            <p class="xp-card__text">{x.text}</p>
            <ul class="xp-card__tags">
              {x.tags.map((t) => (
                <li class="tag">{t}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>

  <div class="marquee" aria-hidden="true">
    {
      [0, 1].map(() => (
        <ul class="marquee__track">
          {marquee.map((m) => (
            <li class="marquee__item">
              {m}
              <span class="marquee__dot" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .expertise {
    background:
      radial-gradient(ellipse 50% 40% at 85% 10%, rgb(17 100 102 / 0.28), transparent 70%),
      var(--c-ink-deep);
    overflow: hidden;
  }

  .xp-grid {
    --mx: -999px;
    --my: -999px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
    border-radius: 6px;
    overflow: hidden;
  }

  .xp-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    background: var(--c-ink-deep);
    isolation: isolate;
  }
  /* Cursor spotlight (coordinates are relative to the grid) */
  .xp-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      420px circle at var(--x, var(--mx)) var(--y, var(--my)),
      rgb(95 212 200 / 0.13),
      transparent 45%
    );
  }

  .xp-card__code {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.2em;
    color: var(--c-peach);
  }
  .xp-card__title {
    font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
  }
  .xp-card__text {
    color: var(--c-text-muted);
    max-width: 42ch;
  }
  .xp-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 1rem;
  }
  .xp-card__tags .tag {
    transition: border-color 0.3s, color 0.3s;
  }
  .xp-card:hover .tag {
    border-color: rgb(95 212 200 / 0.45);
    color: var(--c-mint);
  }

  @media (max-width: 760px) {
    .xp-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Marquee ---------- */
  .marquee {
    display: flex;
    margin-top: clamp(4rem, 2rem + 6vw, 8rem);
    border-block: 1px solid var(--c-line);
    padding-block: 1.75rem;
    user-select: none;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee__track {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 3rem;
    padding-right: 3rem;
    animation: marquee 38s linear infinite;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  .marquee__item {
    display: flex;
    align-items: center;
    gap: 3rem;
    font-family: var(--f-display);
    font-size: clamp(2rem, 1.2rem + 3vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: transparent;
    -webkit-text-stroke: 1px rgb(209 232 226 / 0.35);
    white-space: nowrap;
    transition: color 0.3s, -webkit-text-stroke-color 0.3s;
  }
  .marquee__item:hover {
    color: var(--c-peach);
    -webkit-text-stroke-color: var(--c-peach);
  }
  .marquee__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c-teal);
  }
  @keyframes marquee {
    to {
      transform: translateX(-100%);
    }
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('[data-spotlight]');
  if (grid && window.matchMedia('(hover: hover)').matches) {
    const cards = [...grid.querySelectorAll<HTMLElement>('.xp-card')];
    grid.addEventListener('pointermove', (e) => {
      for (const card of cards) {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--x', `${e.clientX - r.left}px`);
        card.style.setProperty('--y', `${e.clientY - r.top}px`);
      }
    });
    grid.addEventListener('pointerleave', () => {
      cards.forEach((c) => {
        c.style.removeProperty('--x');
        c.style.removeProperty('--y');
      });
    });
  }
</script>
