---
import { Image } from 'astro:assets';
import photo from '../assets/photo.png';
import { projectCount, countByGroup } from '../data/projects';

const stats = [
  { value: projectCount, label: 'Projects shipped' },
  { value: countByGroup('Immersive & WebAR'), label: 'Immersive & WebAR platforms' },
  { value: countByGroup('Brand & Corporate'), label: 'Brand & corporate sites' },
];
---

<section id="about" class="section about theme-light" aria-labelledby="about-title">
  <div class="container about__grid">
    <figure class="about__media" data-reveal>
      <div class="about__frame">
        <Image
          src={photo}
          alt="Stylised portrait of Marco Cabral standing on a neon-lit, rain-soaked city street at night"
          widths={[420, 640, 900]}
          sizes="(min-width: 960px) 40vw, 90vw"
          class="about__photo"
          data-parallax
        />
      </div>
      <figcaption class="about__caption">
        <span>Marco Cabral</span>
        <span>Frontend Developer</span>
      </figcaption>
    </figure>

    <div class="about__body">
      <p class="label" data-reveal>02 — About</p>
      <h2 id="about-title" class="about__statement" data-words>
        I engineer scalable, high-performance web apps and interactive experiences — where solid architecture meets
        pixel-level craft.
      </h2>

      <div class="about__cols">
        <p data-reveal>
          Specialised in the Vue 3 and Nuxt 3 ecosystem with TypeScript, I build modular frontend architectures for
          geospatial and agricultural SaaS, interactive WebAR/WebVR platforms and high-traffic enterprise sites.
        </p>
        <p data-reveal>
          With a background in Communication &amp; Multimedia at UTAD, I care about what people feel — performance,
          accessibility, motion — as much as the code behind it. Years of custom WordPress work taught me to build
          systems teams can actually maintain.
        </p>
      </div>

      <dl class="about__stats">
        {
          stats.map((s) => (
            <div class="about__stat" data-reveal>
              <dt class="about__label">{s.label}</dt>
              <dd class="about__value" data-count={s.value}>
                {s.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 1rem + 6vw, 8rem);
    align-items: center;
  }

  .about__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 6px;
    background: var(--c-ink);
  }
  .about__frame::after {
    /* subtle palette grade */
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(17 100 102 / 0.15), rgb(255 203 154 / 0.12));
    mix-blend-mode: soft-light;
    pointer-events: none;
  }
  .about__photo {
    width: 100%;
    height: 116%;
    object-fit: cover;
    object-position: 50% 30%;
    margin-top: -8%;
  }

  .about__caption {
    display: flex;
    justify-content: space-between;
    margin-top: 1rem;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .about__body {
    display: grid;
    gap: 2rem;
  }

  .about__statement {
    font-size: clamp(1.75rem, 1.1rem + 2.4vw, 3.25rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }
  .about__statement :global(.word) {
    display: inline-block;
  }

  .about__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    color: var(--c-text-muted);
  }

  .about__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--c-line-strong);
  }
  .about__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.4rem;
  }
  .about__value {
    margin: 0;
    font-family: var(--f-display);
    font-size: clamp(2.5rem, 1.5rem + 3vw, 4.25rem);
    font-weight: 500;
    line-height: 1;
    color: var(--c-teal);
    font-variant-numeric: tabular-nums;
  }
  .about__label {
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
  }

  @media (max-width: 960px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .about__media {
      max-width: 460px;
    }
  }
  @media (max-width: 640px) {
    .about__cols {
      grid-template-columns: 1fr;
    }
    .about__stats {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
