---
import SectionHead from './SectionHead.astro';
import ProjectVisual from './ProjectVisual.astro';
import ModelStage from './ModelStage.astro';
import PanoramaStage from './PanoramaStage.astro';
import { featured, archive } from '../data/projects';

const pad = (n: number) => String(n).padStart(2, '0');
const groups = ['All', 'SaaS & Apps', 'Immersive & WebAR', 'Brand & Corporate'] as const;
---

<section id="work" class="section work" aria-labelledby="work-title">
  <div class="container">
    <SectionHead index="01" label="Selected Work" title="Products, platforms & experiences." id="work-title">
      <p>
        From precision-agriculture SaaS to WebAR and virtual tourism — interact with each project below: drag the
        model, look around the tour.
      </p>
    </SectionHead>

    <div class="features">
      {
        featured.map((p, i) => (
          <article class:list={['feature', { 'feature--flip': i % 2 === 1 }]}>
            <div class="feature__visual" data-feature-visual>
              {p.media.kind === 'model' && (
                <ModelStage src={p.media.src} poster={p.media.poster} alt={p.media.alt} credit={p.media.credit} />
              )}
              {p.media.kind === 'panorama' && (
                <PanoramaStage
                  src={p.media.src}
                  srcSmall={p.media.srcSmall}
                  credit={p.media.credit}
                  startYaw={p.media.startYaw}
                />
              )}
              {p.media.kind === 'svg' && <ProjectVisual />}
            </div>

            <div class="feature__info">
              <span class="feature__num" aria-hidden="true">
                {pad(i + 1)}
              </span>
              <p class="feature__meta" data-reveal>
                {p.sector}
              </p>
              <h3 class="feature__title" data-reveal>
                {p.name}
              </h3>
              <p class="feature__summary" data-reveal>
                {p.summary}
              </p>
              <ul class="feature__tags" aria-label="Technologies" data-reveal>
                {p.stack.map((s) => (
                  <li class="tag">{s}</li>
                ))}
              </ul>
              <a class="feature__link" href={p.url} target="_blank" rel="noopener" data-reveal>
                Visit project
                <span class="sr-only">
                  {' '}
                  {p.name} (opens in a new tab)
                </span>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 10L10 2M4 2h6v6" stroke="currentColor" stroke-width="1.4" />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="index">
      <div class="index__head" data-reveal>
        <h3 class="index__title">More projects <span class="index__count">({archive.length})</span></h3>
        <div class="index__filters" role="group" aria-label="Filter projects">
          {
            groups.map((g, i) => (
              <button type="button" class="index__filter" data-filter={g} aria-pressed={i === 0 ? 'true' : 'false'}>
                {g}
              </button>
            ))
          }
        </div>
      </div>

      <ul class="index__list" data-reveal>
        {
          archive.map((p) => (
            <li class="index__row" data-group={p.group}>
              {p.url ? (
                <a class="index__item" href={p.url} target="_blank" rel="noopener">
                  <span class="index__name">{p.name}</span>
                  <span class="index__sector">{p.sector}</span>
                  <span class="index__stack">{p.stack}</span>
                  <svg class="index__arrow" width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M2 10L10 2M4 2h6v6" stroke="currentColor" stroke-width="1.3" />
                  </svg>
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              ) : (
                <div class="index__item index__item--private">
                  <span class="index__name">{p.name}</span>
                  <span class="index__sector">{p.sector}</span>
                  <span class="index__stack">{p.stack}</span>
                  <span class="index__private">Private</span>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .work {
    background: var(--c-ink);
  }

  /* ---------- Featured projects: alternating editorial rows ---------- */
  .features {
    display: grid;
    gap: clamp(5rem, 3rem + 7vw, 10rem);
  }

  .feature {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .feature--flip {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }
  .feature--flip .feature__visual {
    order: 2;
  }

  .feature__visual {
    position: relative;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--c-line);
    border-radius: 6px;
    overflow: hidden;
    background: var(--c-ink-deeper);
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.7);
  }
  /* HUD corner brackets */
  .feature__visual::before,
  .feature__visual::after {
    content: '';
    position: absolute;
    z-index: 4;
    width: 16px;
    height: 16px;
    border: 1px solid var(--c-peach);
    pointer-events: none;
  }
  .feature__visual::before {
    top: 8px;
    left: 8px;
    border-right: 0;
    border-bottom: 0;
  }
  .feature__visual::after {
    right: 8px;
    bottom: 8px;
    border-left: 0;
    border-top: 0;
  }

  .feature__info {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .feature__num {
    font-family: var(--f-display);
    font-size: clamp(4.5rem, 3rem + 5vw, 8.5rem);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px rgb(209 232 226 / 0.25);
    margin-bottom: 0.75rem;
  }

  .feature__meta {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-peach);
  }

  .feature__title {
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.25rem);
  }

  .feature__summary {
    max-width: 40ch;
    color: var(--c-text-muted);
    font-size: var(--fs-lg);
    line-height: 1.55;
  }

  .feature__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .feature__link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--c-line-strong);
    font-size: var(--fs-sm);
    transition: color 0.3s, border-color 0.3s;
  }
  .feature__link svg {
    transition: transform 0.4s var(--ease-out);
  }
  .feature__link:hover {
    color: var(--c-peach);
    border-color: var(--c-peach);
  }
  .feature__link:hover svg {
    transform: translate(3px, -3px);
  }

  @media (max-width: 900px) {
    .feature {
      grid-template-columns: 1fr;
    }
    .feature--flip {
      grid-template-columns: 1fr;
    }
    .feature--flip .feature__visual {
      order: 0;
    }
    .feature__visual {
      aspect-ratio: 1;
    }
    .feature__num {
      font-size: 4rem;
      margin-bottom: 0;
    }
  }

  /* ---------- Project index ---------- */
  .index {
    margin-top: clamp(6rem, 4rem + 6vw, 11rem);
  }

  .index__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--c-line-strong);
  }
  .index__title {
    font-size: var(--fs-xl);
  }
  .index__count {
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    color: var(--c-teal-glow);
    vertical-align: super;
  }

  .index__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .index__filter {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--c-line-strong);
    border-radius: 100px;
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--c-text-muted);
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
  }
  .index__filter:hover {
    color: var(--c-mint);
    border-color: var(--c-mint);
  }
  .index__filter[aria-pressed='true'] {
    background: var(--c-peach);
    border-color: var(--c-peach);
    color: var(--c-ink-deeper);
  }

  .index__row[hidden] {
    display: none;
  }

  .index__item {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 3fr) minmax(0, 4fr) 2rem;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 0.75rem;
    border-bottom: 1px solid var(--c-line);
    isolation: isolate;
    transition: color 0.3s, padding 0.5s var(--ease-out);
  }
  .index__item::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(17 100 102 / 0.55), rgb(17 100 102 / 0.1));
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.45s var(--ease-out);
  }
  a.index__item:hover {
    padding-left: 1.5rem;
  }
  a.index__item:hover::before {
    transform: scaleY(1);
  }

  .index__name {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    font-weight: 500;
  }
  .index__sector,
  .index__stack {
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
  }
  .index__stack {
    font-family: var(--f-mono);
    font-size: 0.72rem;
  }
  .index__arrow {
    justify-self: end;
    color: var(--c-peach);
    transition: transform 0.4s var(--ease-out);
  }
  a.index__item:hover .index__arrow {
    transform: translate(3px, -3px) scale(1.2);
  }
  .index__private {
    justify-self: end;
    font-family: var(--f-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-beige);
  }

  @media (max-width: 760px) {
    .index__item {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.25rem 1rem;
    }
    .index__sector {
      grid-column: 1;
      grid-row: 2;
    }
    .index__stack {
      display: none;
    }
    .index__arrow,
    .index__private {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.index__filter');
  const rows = document.querySelectorAll<HTMLElement>('.index__row');

  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      rows.forEach((row) => {
        row.hidden = filter !== 'All' && row.dataset.group !== filter;
      });
    }),
  );
</script>
