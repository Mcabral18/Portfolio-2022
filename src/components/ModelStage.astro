---
interface Props {
  src: string;
  alt: string;
  credit: string;
  poster: string;
}
const { src, alt, credit, poster } = Astro.props;
---

<div class="stage stage--model" data-model-stage>
  <img class="stage__poster" src={poster} alt="" width="800" height="800" loading="lazy" decoding="async" />

  <model-viewer
    src={src}
    alt={alt}
    camera-controls
    disable-zoom
    disable-pan
    auto-rotate
    auto-rotate-delay="1500"
    rotation-per-second="16deg"
    interaction-prompt="none"
    touch-action="pan-y"
    camera-orbit="0deg 80deg 105%"
    shadow-intensity="1.2"
    shadow-softness="0.9"
    exposure="1.05"
    environment-image="neutral"
    ar
    ar-modes="webxr scene-viewer quick-look"
    loading="lazy"
    reveal="auto"
  >
    <button slot="ar-button" class="stage__ar" type="button">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M12 2l9 5v10l-9 5-9-5V7z M3 7l9 5 9-5 M12 12v10"></path>
      </svg>
      View in your space
    </button>
    <div slot="progress-bar"></div>
  </model-viewer>

  <!-- Mobile / low-power: 3D is opt-in -->
  <button class="stage__load" type="button" data-load hidden>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M12 2l9 5v10l-9 5-9-5V7z M3 7l9 5 9-5 M12 12v10"></path>
    </svg>
    Tap to view in 3D
  </button>

  <div class="stage__loader" data-loader aria-hidden="true" hidden>
    <span>Loading 3D model</span>
    <span class="stage__bar"><i data-bar></i></span>
  </div>

  <div class="stage__hud" aria-hidden="true">
    <span class="stage__chip"><i class="stage__live"></i>3D · WebAR ready</span>
  </div>
  <p class="stage__hint" aria-hidden="true">Drag to orbit</p>
  <p class="stage__credit">{credit}</p>
</div>

<style>
  .stage--model {
    background:
      radial-gradient(ellipse 55% 50% at 50% 55%, rgb(17 100 102 / 0.45), transparent 70%),
      radial-gradient(ellipse 30% 20% at 50% 88%, rgb(255 203 154 / 0.12), transparent 70%),
      var(--c-ink-deeper);
  }

  /* Static preview: fades into the stage background, swapped out once the 3D is ready */
  .stage__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mask-image: radial-gradient(ellipse 48% 50% at 50% 50%, #000 55%, transparent 100%);
    mix-blend-mode: lighten;
    opacity: 0.9;
    transition: opacity 0.8s var(--ease-out);
  }
  .stage--model.is-loaded .stage__poster {
    opacity: 0;
  }

  model-viewer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    --poster-color: transparent;
    --progress-bar-height: 0;
    opacity: 0;
    transition: opacity 0.8s var(--ease-out);
  }
  .stage--model.is-loaded model-viewer {
    opacity: 1;
  }

  /* The hint only makes sense once the model is interactive */
  .stage--model:not(.is-loaded) .stage__hint {
    display: none;
  }

  .stage__load {
    position: absolute;
    left: 50%;
    bottom: 2.25rem;
    z-index: 3;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--c-peach);
    background: rgb(20 26 25 / 0.85);
    color: var(--c-peach);
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .stage__load[hidden],
  .stage__loader[hidden] {
    display: none;
  }

  .stage__ar {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--c-peach);
    background: rgb(20 26 25 / 0.85);
    color: var(--c-peach);
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
</style>

<script>
  // Phones / tablets / low-memory devices: don't download ~2.5 MB of 3D unless asked.
  const nav = navigator as Navigator & { deviceMemory?: number; connection?: { saveData?: boolean } };
  const lite =
    window.matchMedia('(max-width: 900px), (pointer: coarse)').matches ||
    (nav.deviceMemory ?? 8) <= 4 ||
    nav.connection?.saveData === true;

  document.querySelectorAll<HTMLElement>('[data-model-stage]').forEach((stage) => {
    const viewer = stage.querySelector('model-viewer')!;
    const bar = stage.querySelector<HTMLElement>('[data-bar]')!;
    const loader = stage.querySelector<HTMLElement>('[data-loader]')!;
    const loadBtn = stage.querySelector<HTMLButtonElement>('[data-load]')!;

    viewer.addEventListener('progress', (e) => {
      const p = (e as CustomEvent<{ totalProgress: number }>).detail.totalProgress;
      bar.style.transform = `scaleX(${p})`;
    });
    viewer.addEventListener('load', () => {
      stage.classList.add('is-loaded');
      loader.hidden = true;
    });
    viewer.addEventListener('camera-change', (e) => {
      if ((e as CustomEvent<{ source: string }>).detail.source === 'user-interaction') {
        stage.classList.add('has-interacted');
      }
    });

    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      loadBtn.hidden = true;
      loader.hidden = false;
      if (lite) {
        // cheaper rendering on mobile GPUs
        viewer.setAttribute('shadow-intensity', '0');
        viewer.setAttribute('loading', 'eager');
      }
      import('@google/model-viewer');
    };

    if (lite) {
      loadBtn.hidden = false;
      loadBtn.addEventListener('click', start);
    } else {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          start();
        },
        { rootMargin: '150px 0px' },
      );
      io.observe(stage);
    }
  });
</script>
